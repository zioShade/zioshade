.{
    .name = .zioshade,
    .version = "0.5.0",
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        // Dual-version (0.15.2 + 0.16) monotonic-clock lib. compat.zig's
        // Timer/monotonic shim delegates to it (this is ziotime's reason to
        // exist: centralize the 0.16 std.Io.Clock churn in one place).
        .ziotime = .{
            .url = "https://github.com/deblasis/ziotime/archive/refs/tags/v0.1.1.tar.gz",
            .hash = "ziotime-0.1.1-QxPLaTtlAABJbgiJuTs7d3ZN_vMPRKVuzSCVqG8Qzzsg",
        },
        // Dual-version JSON escaper over std.Io.Writer (present on both 0.15.2
        // and 0.16). reflection.zig's hand-rolled string escaper delegates to it.
        .ziojson = .{
            .url = "https://github.com/deblasis/ziojson/archive/refs/tags/v0.4.2.tar.gz",
            .hash = "ziojson-0.4.2-5G9pUsfZAABpZ1uCjrArX5qn7j5tjUolykMfiptcVJvT",
        },
    },
    .paths = .{
        "LICENSE-APACHE",
        "LICENSE-MIT",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
        "build.zig",
        "build.zig.zon",
        "build_compat.zig",
        "include",
        "src",
        "examples",
    },
    .fingerprint = 0x8a823918dadacdf2,
}
