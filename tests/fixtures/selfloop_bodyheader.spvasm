; Minimal DETERMINISTIC reproducer for the self-loop-with-body-in-header GLSL bug.
; Loop header %hdr IS the continue target (OpLoopMerge %merge %hdr -> continue==header),
; and the body (load acc / add / store) sits IN the header before the LoopMerge.
; acc accumulates i over the loop; output = float(acc). In-bounds, no chaos, hand-computable.
;   do { acc += i; } while(++i < 10)  -> acc = 0+1+...+10 = 55 -> outColor = (55,55,55,1)
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %outColor
OpExecutionMode %main OriginUpperLeft
OpDecorate %outColor Location 0

%void = OpTypeVoid
%voidfn = OpTypeFunction %void
%float = OpTypeFloat 32
%int = OpTypeInt 32 1
%bool = OpTypeBool
%v4float = OpTypeVector %float 4
%ptr_int_Function = OpTypePointer Function %int
%ptr_v4_out = OpTypePointer Output %v4float

%int_0 = OpConstant %int 0
%int_1 = OpConstant %int 1
%int_10 = OpConstant %int 10
%float_0 = OpConstant %float 0
%float_1 = OpConstant %float 1

%outColor = OpVariable %ptr_v4_out Output

%main = OpFunction %void None %voidfn
%entry = OpLabel
%acc = OpVariable %ptr_int_Function Function
OpStore %acc %int_0
OpBranch %hdr
%hdr = OpLabel
%i = OpPhi %int %int_0 %entry %inext %hdr
%ld = OpLoad %int %acc
%add = OpIAdd %int %ld %i
OpStore %acc %add
%cond = OpSLessThan %bool %i %int_10
%inext = OpIAdd %int %i %int_1
OpLoopMerge %merge %hdr None
OpBranchConditional %cond %hdr %merge
%merge = OpLabel
%final = OpLoad %int %acc
%finalf = OpConvertSToF %float %final
%color = OpCompositeConstruct %v4float %finalf %finalf %finalf %float_1
OpStore %outColor %color
OpReturn
OpFunctionEnd
